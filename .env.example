# Copy to .env and fill in. Read at runtime by app/lib/portal.server.ts.
#
# Base URL of the 7DT GW Portal public API, without a trailing slash. The site
# calls <base>/status/ and <base>/tiles/ from the server only; the address is
# never exposed to a browser and is deliberately not committed to this
# repository. If unset, the survey status page falls back to the snapshot in
# app/routes/content/status-snapshot.json and the sky map renders empty.
PORTAL_API_BASE=

# Optional. How long each payload is served before a background refresh, in
# minutes. Defaults: status 30, tiles 1440 (once a day). The tile list is ~2 MB
# and only changes after an observing night ends, so a daily refresh is enough.
PORTAL_TTL_STATUS_MIN=
PORTAL_TTL_TILES_MIN=

# Optional. Addresses of the project's operational services, shown on
# /users/links. Each appears only when set, so an unset value simply means the
# service is not linked publicly. Kept out of the repository for the same
# reason as PORTAL_API_BASE.
LINK_WIKI=
LINK_PIPELINE=
LINK_TOO=
LINK_PORTAL=
